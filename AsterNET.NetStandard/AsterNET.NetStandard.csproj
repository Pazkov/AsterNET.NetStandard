<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>Pazkov.AsterNET.NetStandard</PackageId>
    <Description>AsterNET.NetStandard fork with Asterisk 12+ compatibility fixes
</Description>
    <Copyright></Copyright>
    <PackageProjectUrl>https://github.com/Pazkov/AsterNET.NetStandard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Pazkov/AsterNET.NetStandard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>asternet, asterisk, asterisk net core, asternet net core, asternet standard, asternet net standard, asterisk net standard</PackageTags>
    <PackageReleaseNotes>v2.4.2:
- Fixed Asterisk version auto-detection for Asterisk 13+ (16, 18, 20, 21, etc.) to correctly use comma as variable separator during Originate action.

v2.4.0:
- Fixed property shadowing in QueueMember*Event classes (properties were hiding base class members)
- Fixed AddKeyValue to concatenate duplicate AMI keys instead of overwriting
- Fixed thread-safety: added lock on socket write for concurrent AMI actions
- Added events: DTMFBegin, DTMFEnd, HangupRequest, MusicOnHold, MusicOnHoldStart, MusicOnHoldStop, QueueSummary</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>MRebati, Pazkov</Authors>
    <Company>RebatiNet</Company>
    <Version>2.4.2</Version>
    <AssemblyVersion>2.4.2.0</AssemblyVersion>
    <FileVersion>2.4.2.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
